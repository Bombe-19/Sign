# ==============================================================================
# SureSign - Master Root .gitignore
# ==============================================================================

# Node / Frontend Build & Dependencies
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
venv/
env/
ENV/
.venv/

# Backend Uploads & Temporary Storage
backend/uploads/*
!backend/uploads/.gitkeep
backend/static/temp/*

# Heavy Model Weights (Keep local, preserve instructions)
backend/models/*.h5
backend/models/*.keras
backend/models/*.onnx
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin
!backend/models/README.md
!backend/models/.gitkeep

# IDEs & Operating System Artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

tests/
